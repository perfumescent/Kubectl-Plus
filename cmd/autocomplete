#!/usr/bin/env bash

# Get namespaces for completion
function _get_namespaces() {
    # Cache namespaces for 5 seconds to avoid too many API calls
    local cache_file="/tmp/kp_ns_cache"
    local cache_age=5  # seconds

    if [ -f "$cache_file" ]; then
        # Check if cache is still valid
        if [ $(($(date +%s) - $(stat -c %Y "$cache_file"))) -lt $cache_age ]; then
            cat "$cache_file"
            return
        fi
    fi

    # Get fresh namespace list and update cache
    kubectl get ns 2>/dev/null | tail -n +2 | awk '{print $1}' | tee "$cache_file"
}

# Get pods in specified namespace
function _get_pods() {
    local namespace="$1"
    kubectl -n $namespace get pod 2>/dev/null | tail -n +2 | awk '{print $1}'
}

# Get services in specified namespace
function _get_services() {
    local namespace="$1"
    kubectl -n $namespace get svc 2>/dev/null | tail -n +2 | awk '{print $1}'
}

# Get resource types for p command
function _get_resources() {
    echo "pod svc deploy rs sts"
}

# Handle namespace parameter completion
function _handle_namespace_completion() {
    local cur="$1"
    local prev="$2"

    # Case 1: Handle partial parameter input (e.g. -n, --n)
    if [[ "$cur" == -* ]]; then
        if [[ "$cur" == --n* ]]; then
            COMPREPLY=($(compgen -W "--namespace" -- "$cur"))
            return 0
        elif [[ "$cur" == -n* ]]; then
            COMPREPLY=($(compgen -W "-n --namespace" -- "$cur"))
            return 0
        fi
    fi

    # Case 2: Handle namespace completion after parameter
    if [[ "$prev" == "-n" || "$prev" == "--namespace" ]]; then
        local namespaces=$(_get_namespaces)
        if [ -n "$namespaces" ]; then
            COMPREPLY=($(compgen -W "$namespaces" -- "$cur"))
        fi
        return 0
    fi

    return 1
}

# kp 命令补全函数
_kp_completion() {
    local cur prev words cword
    _get_comp_words_by_ref -n : cur prev words cword

    # 子命令列表
    local commands="p f l i"
    
    # 全局选项
    local global_opts="-h --help -v --version"
    
    # 如果是第一个参数，补全子命令和全局选项
    if [ $cword -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$commands $global_opts" -- "$cur") )
        return 0
    fi

    # 获取子命令
    local subcmd="${words[1]}"
    
    # 根据子命令调用对应的补全函数
    case "$subcmd" in
        p)
            _kp_p_completion
            ;;
        f)
            _kp_f_completion
            ;;
        l)
            _kp_l_completion
            ;;
        i)
            _kp_i_completion
            ;;
    esac
}

# p 命令补全
_kp_p_completion() {
    local cur prev words cword
    _get_comp_words_by_ref -n : cur prev words cword

    # 资源类型
    local resources="pod svc deploy rs sts"
    # 选项
    local opts="-n --namespace -o --output -l --selector -A --all-namespaces -S --sort"
    
    case "$prev" in
        -n|--namespace)
            COMPREPLY=( $(compgen -W "$(kubectl get ns -o name | cut -d/ -f2)" -- "$cur") )
            return 0
            ;;
        -o|--output)
            COMPREPLY=( $(compgen -W "json yaml wide custom" -- "$cur") )
            return 0
            ;;
        -S|--sort)
            COMPREPLY=( $(compgen -W "name status age" -- "$cur") )
            return 0
            ;;
        *)
            COMPREPLY=( $(compgen -W "$resources $opts" -- "$cur") )
            return 0
            ;;
    esac
}

# f 命令补全
_kp_f_completion() {
    local cur prev words cword
    _get_comp_words_by_ref -n : cur prev words cword

    local opts="-n --namespace -c --container -p --path -C --context -t --tail"
    
    case "$prev" in
        -n|--namespace)
            COMPREPLY=( $(compgen -W "$(kubectl get ns -o name | cut -d/ -f2)" -- "$cur") )
            return 0
            ;;
        -c|--container)
            local ns pod
            ns=$(echo "${words[@]}" | grep -o '\(-n\|--namespace\) [^ ]*' | cut -d' ' -f2)
            [ -z "$ns" ] && ns="default"
            pod="${words[2]}"
            COMPREPLY=( $(compgen -W "$(kubectl get pod $pod -n $ns -o jsonpath='{.spec.containers[*].name}')" -- "$cur") )
            return 0
            ;;
        *)
            COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
            return 0
            ;;
    esac
}

