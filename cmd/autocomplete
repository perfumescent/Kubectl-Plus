_kp_l_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local namespace="default"

    local opts="-n --namespace -c --container -p --path -s --since -t --tail -f --follow"
    
    # 获取当前命名空间
    for ((i=1; i<${#COMP_WORDS[@]}-1; i++)); do
        if [[ "${COMP_WORDS[i]}" == "-n" || "${COMP_WORDS[i]}" == "--namespace" ]]; then
            namespace="${COMP_WORDS[i+1]}"
            break
        fi
    done
    
    case "$prev" in
        -n|--namespace)
            COMPREPLY=( $(compgen -W "$(_get_namespaces)" -- "$cur") )
            return 0
            ;;
        -c|--container)
            local pod="${COMP_WORDS[2]}"
            COMPREPLY=( $(compgen -W "$(kubectl get pod $pod -n $namespace -o jsonpath='{.spec.containers[*].name}' 2>/dev/null)" -- "$cur") )
            return 0
            ;;
        *)
            if [[ $COMP_CWORD -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_get_pods $namespace)" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
            fi
            return 0
            ;;
    esac
}

# i 命令补全
_kp_i_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local namespace="default"

    local opts="-n --namespace -c --container -s --shell -u --user"
    
    # 获取当前命名空间
    for ((i=1; i<${#COMP_WORDS[@]}-1; i++)); do
        if [[ "${COMP_WORDS[i]}" == "-n" || "${COMP_WORDS[i]}" == "--namespace" ]]; then
            namespace="${COMP_WORDS[i+1]}"
            break
        fi
    done
    
    case "$prev" in
        -n|--namespace)
            COMPREPLY=( $(compgen -W "$(_get_namespaces)" -- "$cur") )
            return 0
            ;;
        -c|--container)
            local pod="${COMP_WORDS[2]}"
            COMPREPLY=( $(compgen -W "$(kubectl get pod $pod -n $namespace -o jsonpath='{.spec.containers[*].name}' 2>/dev/null)" -- "$cur") )
            return 0
            ;;
        -s|--shell)
            COMPREPLY=( $(compgen -W "sh bash zsh" -- "$cur") )
            return 0
            ;;
        *)
            if [[ $COMP_CWORD -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_get_pods $namespace)" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
            fi
            return 0
            ;;
    esac
}

# Register completions
complete -F _kp_completion kp

