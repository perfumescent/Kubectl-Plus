#!/usr/bin/env bash

# Get namespaces for completion
_get_namespaces() {
    # Cache namespaces for 5 seconds to avoid too many API calls
    local cache_file="/tmp/kp_ns_cache"
    local cache_age=5  # seconds

    if [ -f "$cache_file" ]; then
        # Check if cache is still valid
        if [ $(($(date +%s) - $(stat -c %Y "$cache_file"))) -lt $cache_age ]; then
            cat "$cache_file"
            return
        fi
    fi

    # Get fresh namespace list and update cache
    kubectl get ns 2>/dev/null | tail -n +2 | awk '{print $1}' | tee "$cache_file"
}

# Get pods in specified namespace
_get_pods() {
    local namespace="$1"
    kubectl -n $namespace get pod 2>/dev/null | tail -n +2 | awk '{print $1}'
}

# Get services in specified namespace
_get_services() {
    local namespace="$1"
    kubectl -n $namespace get svc 2>/dev/null | tail -n +2 | awk '{print $1}'
}

# Get resource types for p command
_get_resources() {
    echo "pod svc deploy rs sts"
}

# kp 命令补全函数
_kp_completion() {
    local cur prev words
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    words=("${COMP_WORDS[@]}")

    # 子命令列表
    local commands="p f l i"
    
    # 全局选项
    local global_opts="-h --help -v --version"
    
    # 如果是第一个参数，补全子命令和全局选项
    if [ $COMP_CWORD -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$commands $global_opts" -- "$cur") )
        return 0
    fi

    # 获取子命令
    local subcmd="${words[1]}"
    
    # 根据子命令调用对应的补全函数
    case "$subcmd" in
        p)
            _kp_p_completion
            ;;
        f)
            _kp_f_completion
            ;;
        l)
            _kp_l_completion
            ;;
        i)
            _kp_i_completion
            ;;
    esac
}

# p 命令补全
_kp_p_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"

    # 资源类型
    local resources="pod svc deploy rs sts"
    # 选项
    local opts="-n --namespace -o --output -l --selector -A --all-namespaces -S --sort"
    
    case "$prev" in
        -n|--namespace)
            COMPREPLY=( $(compgen -W "$(_get_namespaces)" -- "$cur") )
            return 0
            ;;
        -o|--output)
            COMPREPLY=( $(compgen -W "json yaml wide custom" -- "$cur") )
            return 0
            ;;
        -S|--sort)
            COMPREPLY=( $(compgen -W "name status age" -- "$cur") )
            return 0
            ;;
        *)
            COMPREPLY=( $(compgen -W "$resources $opts" -- "$cur") )
            return 0
            ;;
    esac
}

# f 命令补全
_kp_f_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local namespace="default"

    local opts="-n --namespace -c --container -p --path -C --context -t --tail"
    
    # 获取当前命名空间
    for ((i=1; i<${#COMP_WORDS[@]}-1; i++)); do
        if [[ "${COMP_WORDS[i]}" == "-n" || "${COMP_WORDS[i]}" == "--namespace" ]]; then
            namespace="${COMP_WORDS[i+1]}"
            break
        fi
    done
    
    case "$prev" in
        -n|--namespace)
            COMPREPLY=( $(compgen -W "$(_get_namespaces)" -- "$cur") )
            return 0
            ;;
        -c|--container)
            local pod="${COMP_WORDS[2]}"
            COMPREPLY=( $(compgen -W "$(kubectl get pod $pod -n $namespace -o jsonpath='{.spec.containers[*].name}' 2>/dev/null)" -- "$cur") )
            return 0
            ;;
        *)
            if [[ $COMP_CWORD -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_get_services $namespace)" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
            fi
            return 0
            ;;
    esac
}

